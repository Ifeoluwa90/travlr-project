<div class="box">
    <div>
        <div class="body">
            <h1>Travel</h1>
            <ul id="sites">
                {{#each trips}}
                <li>
                    <a href="/travel"><img src="images/{{this.image}}" alt="{{this.name}}"></a>
                    <h2><a href="/travel">{{this.name}}</a></h2>
                    <p>
                        {{this.description}}
                    </p>
                    <p>
                        <strong>Length:</strong> {{this.length}}<br>
                        <strong>Start Date:</strong> {{this.start}}<br>
                        <strong>Resort:</strong> {{this.resort}}<br>
                        <strong>Price per Person:</strong> ${{this.perPerson}}
                    </p>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>
</div>